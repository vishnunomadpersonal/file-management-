ENV="dev"
APP_UPLOAD_DIR="/uploads"
APP_MAX_CHUNK_SIZE="10485760"

MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_PUBLIC_BUCKET="public"
MINIO_PRIVATE_BUCKET="private"
MINIO_ENDPOINT="minio:9000"
MINIO_URL="http://localhost:9001"

MYSQL_ROOT_PASSWORD="my_root_password"
MYSQL_USER="filemanager_user"
MYSQL_PASSWORD="filemanager_pass"
MYSQL_HOST="db-mysql"
MYSQL_PORT="3306"
MYSQL_DATABASE="filemanager"
MYSQL_TEST_DATABASE="filemanager_test"

RABBITMQ_DEFAULT_USER="guest"
RABBITMQ_DEFAULT_PASS="guest"
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT="5672"

CLAMAV_REST_URL=http://clamav-rest:3000
VIRUS_SCAN_ENABLED=true
QUARANTINE_INFECTED_FILES=true
DELETE_INFECTED_FILES=false
MAX_SCAN_FILE_SIZE=104857600

CELERY_BACKEND_ENDPOINT=db+mysql://filemanager_user:filemanager_pass@db-mysql/filemanager

# Keycloak Enterprise IAM Configuration
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=filemanager
KEYCLOAK_CLIENT_ID=filemanager-api
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ENABLED=true
KEYCLOAK_REDIRECT_URI=http://localhost:8000/api/v1/keycloak/login/oauth2/callback

# Keycloak DB (used by docker-compose)
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_password
KEYCLOAK_DB_NAME=keycloak

# Kong API Gateway Configuration
KONG_DATABASE=postgres
KONG_PG_HOST=kong-db
KONG_PG_PORT=5432
KONG_PG_USER=kong
KONG_PG_PASSWORD=kongpass
KONG_PG_DATABASE=kong
KONG_ADMIN_LISTEN=0.0.0.0:8001
KONG_PROXY_LISTEN=0.0.0.0:8000
KONG_LOG_LEVEL=info
KONG_PLUGINS=bundled,prometheus

# JWT Settings (for internal auth)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Multi-tenant Settings
MULTI_TENANT_ENABLED=true
DEFAULT_TENANT_PLAN=free
SELF_REGISTRATION_ENABLED=false
