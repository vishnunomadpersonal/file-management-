# ============================================================================
# CHATBOT CONFIGURATION
# ============================================================================
# 
# The chatbot has three modes:
# 1. Disabled (CHATBOT_ENABLED=false) - App works normally, no chatbot
# 2. Rule-based (LLM_PROVIDER=none) - Basic chatbot, no AI costs
# 3. AI-powered (LLM_PROVIDER=openai|ollama) - Smart chatbot with AI
#

# Feature flag - enable/disable chatbot completely
CHATBOT_ENABLED=true

# LLM Provider: "openai", "ollama", or "none"
# - openai: Cloud-based, requires API key, has costs
# - ollama: Local LLM, free but requires Ollama server running
# - none: Rule-based only, no AI, instant responses
LLM_PROVIDER=none

# ============================================================================
# OpenAI Settings (only used if LLM_PROVIDER=openai)
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7

# ============================================================================
# Ollama Settings (only used if LLM_PROVIDER=ollama)
# ============================================================================
# Run Ollama locally: https://ollama.ai/download
# Then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60

# ============================================================================
# General Chatbot Settings
# ============================================================================
# Maximum messages to keep in conversation history
CHATBOT_MAX_HISTORY=20

# Custom system prompt (optional - defaults to built-in prompt)
# CHATBOT_SYSTEM_PROMPT="You are a helpful assistant for FileVault..."

# ============================================================================
# QUICK START EXAMPLES
# ============================================================================
#
# 1. FREE Local AI (recommended for development):
#    - Install Ollama from https://ollama.ai
#    - Run: ollama pull llama3.2
#    - Set: CHATBOT_ENABLED=true, LLM_PROVIDER=ollama
#
# 2. Production with OpenAI:
#    - Get API key from https://platform.openai.com
#    - Set: CHATBOT_ENABLED=true, LLM_PROVIDER=openai, OPENAI_API_KEY=sk-...
#
# 3. Basic rule-based (no AI):
#    - Set: CHATBOT_ENABLED=true, LLM_PROVIDER=none
#
# 4. Disabled (no chatbot):
#    - Set: CHATBOT_ENABLED=false
#
